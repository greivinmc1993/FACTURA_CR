{
  "name": "facturacr-desktop",
  "private": true,
  "version": "0.6.10",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite --host 127.0.0.1",
    "desktop:dev": "concurrently -k -n SERVER,CLIENT,ELECTRON \"npm:server\" \"npm:client\" \"npm:desktop:electron\"",
    "desktop:electron": "wait-on http://127.0.0.1:5173 http://127.0.0.1:3001 && electron . --dev",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "description": "FacturaCR - gestión local multiempresa, clientes tributarios e inventario",
  "main": "electron/main.cjs",
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "cr.facturacr.desktop",
    "productName": "FacturaCR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FacturaCR"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@44.10.1": true,
    "esbuild@0.25.12": true
  },
  "author": "DojoCodingLabs"
}
